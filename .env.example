# ==============================================
# CloudPaaS Web Hosting - Variables de Entorno
# ==============================================

# Entorno general
PROJECT_NAME="CloudPaaS Web Hosting"
ENVIRONMENT=development
API_V1_STR="/api/v1"
SECRET_KEY="tu_clave_secreta_jwt_para_desarrollo_cambiar_en_produccion"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Base de datos PostgreSQL
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=paas_admin
POSTGRES_PASSWORD=paas_secret_password
POSTGRES_DB=paas_db

# Configuración de Docker Engine & Hosting
# En Linux: /var/run/docker.sock
# En Windows Docker Desktop: npipe:////./pipe/docker_engine (o dejar vacío para detección automática)
DOCKER_SOCKET_PATH=/var/run/docker.sock
DOCKER_IMAGE_NAME=cloudpaas/nginx-hosting:latest
DOCKER_NETWORK=paas_instances_network
HOST_PUBLIC_IP=100.112.65.75
HOSTING_STORAGE_PATH=/srv/hosting/instancias
PORT_RANGE_START=30001
PORT_RANGE_END=30100

# Frontend URL (CORS)
FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:8000/api/v1

# =============================================================
# Envío de Correos Transaccionales (Brevo API REST - Recomendado)
# =============================================================
# 1. Tu API Key generada en Brevo (con permiso: Emails transaccionales -> Todos)
BREVO_API_KEY=tu_clave_api_xkeysib_aqui
# 2. Correo de remitente previamente verificado en Brevo (Senders & IP)
BREVO_SENDER_EMAIL=tu_correo_verificado@tudominio.com
# 3. Nombre que verán los usuarios como remitente
BREVO_SENDER_NAME="CloudPaaS"

# =============================================================
# Envío de Correos Alternativo (SMTP)
# =============================================================
PASSWORD_RESET_SMTP_HOST=
PASSWORD_RESET_SMTP_PORT=1025
PASSWORD_RESET_SMTP_SECURITY=none
PASSWORD_RESET_FROM_EMAIL=
PASSWORD_RESET_SMTP_USERNAME=
PASSWORD_RESET_SMTP_PASSWORD=
PASSWORD_RESET_FRONTEND_URL=http://localhost:5173/
