[Unit]
Description=CloudPaaS Docker Orphan Container and DB Reconciliation Service
After=docker.service network.target
Requires=docker.service

[Service]
Type=oneshot
User=root
ExecStart=/bin/bash -c '/usr/local/bin/cloudpaas-cleanup || /srv/hosting/infra/scripts/cron_cleanup_orphans.sh'
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
